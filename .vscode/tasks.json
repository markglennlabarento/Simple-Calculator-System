{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Calculator",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-I",
                "${workspaceFolder}\\include",
                "${workspaceFolder}\\src\\Calculator.cpp",
                "${workspaceFolder}\\src\\main.cpp",
                "-o",
                "${workspaceFolder}\\calculator.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}